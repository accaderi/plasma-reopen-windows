#!/usr/bin/python3
"""plasma-reopen-windows: "Save & Shut Down" / "Save & Restart" for KDE Plasma 6.

On a normal log-out, Plasma closes the windows of every app one by one. Apps
that restore their own windows (Chrome, VS Code, Dolphin) then only remember
the window closed last, and on Wayland nothing puts the windows back where
they were. This tool does it the other way round:

  save      record every window (app, screen, position, size, desktop,
            minimized/maximized), the folders of each Konsole tab, then quit
            each app *as a whole* so it saves all its windows, and write
            ~/.local/state/plasma-reopen-windows/session.json
  shutdown  save, then shut down through Plasma
  reboot    save, then restart through Plasma
  restore   at login (autostart): start the saved apps again and put their
            windows back
  status    show what is saved, change nothing
  windows   list the open windows as this tool sees them

Nothing is ever killed: an app that does not close by itself (for example
because it asks to save a document) stops the shutdown, and the apps closed
so far are started again.
"""

import configparser
import difflib
import json
import os
import pwd
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import warnings

from gi.repository import Gio, GLib

warnings.filterwarnings("ignore", category=DeprecationWarning)   # Gio register_object

# ---- paths and settings ------------------------------------------------------
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                         "plasma-reopen-windows")
STATE = os.path.join(STATE_DIR, "session.json")
LOG = os.path.join(STATE_DIR, "log")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                    "plasma-reopen-windows.conf")

DEFAULTS = {
    "confirm": "yes",           # ask before closing everything
    "place_windows": "auto",    # yes / no / auto (= no if "Remember Window Positions" is on)
    "close_timeout": "30",      # seconds an app may take to close
    "restore_timeout": "120",   # seconds to wait for windows after login
    "max_age_days": "7",        # older saved sessions are not restored
    "exclude": "",              # extra app ids to leave alone, space separated
    "restore_stacking": "yes",  # put windows back in the same order on top of each other
}

# Apps that restore all their own windows when quit as a whole: quit with SIGTERM
QUIT_BY_SIGNAL = {
    "google-chrome", "com.google.Chrome", "chromium-browser", "chromium", "org.chromium.Chromium",
    "brave-browser", "com.brave.Browser", "microsoft-edge", "com.microsoft.Edge", "vivaldi-stable",
    "code", "com.microsoft.VSCode", "code-oss", "codium", "com.vscodium.codium",
}
# Never touched: desktop shell, helpers, tray tools
IGNORE = {
    "plasmashell", "org.kde.plasmashell", "org.kde.krunner", "krunner", "kwin", "org.kde.kwin",
    "xwaylandvideobridge", "org.kde.xwaylandvideobridge", "org.kde.polkit-kde-authentication-agent-1",
    "org.kde.kwalletd6", "org.kde.kwalletd5", "org.kde.ksmserver", "org.kde.plasma-systemmonitor-applet",
    "org.kde.spectacle", "kdialog", "org.kde.kdialog",
}
# Quit order: everything else first (most likely to ask about unsaved work),
# then the apps that restore themselves.
ORDER = {"generic": 0, "konsole": 1, "dolphin": 2, "signal": 3}

BUS_NAME = "io.github.plasma_reopen_windows"
BUS_XML = ('<node><interface name="%s"><method name="Result">'
           '<arg type="s" direction="in"/></method></interface></node>' % BUS_NAME)


def load_conf():
    cp = configparser.ConfigParser()
    cp["general"] = DEFAULTS
    cp.read(CONF)
    return cp["general"]


CFG = load_conf()


def log(msg):
    os.makedirs(STATE_DIR, exist_ok=True)
    line = time.strftime("%F %T ") + msg
    print(msg, flush=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def notify(title, body="", critical=False):
    cmd = ["notify-send", "-a", "Reopen windows", "-i", "system-shutdown"]
    if critical:
        cmd += ["-u", "critical"]
    subprocess.run(cmd + [title, body], check=False)


# ---- talking to KWin ---------------------------------------------------------
class KWin:
    """Runs small KWin scripts; they send their result back over D-Bus."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.result = None
        self.loop = GLib.MainLoop()
        info = Gio.DBusNodeInfo.new_for_xml(BUS_XML).interfaces[0]
        self.bus.register_object("/", info, self._on_call)
        self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                           "RequestName", GLib.Variant("(su)", (BUS_NAME, 4)), None, 0, -1)
        self.tmp = tempfile.mkdtemp(prefix="plasma-reopen-windows-")

    def _on_call(self, conn, sender, path, iface, method, params, inv):
        self.result = params.unpack()[0]
        inv.return_value(None)
        self.loop.quit()

    def _kwin(self, path, iface, method, args, sig):
        return self.bus.call_sync("org.kde.KWin", path, iface, method, args,
                                  GLib.VariantType(sig), 0, 10000).unpack()

    def run(self, js, timeout=10):
        """Run a script; it must end with result(<json-able value>)."""
        src = ("function result(v) { callDBus('%s', '/', '%s', 'Result', JSON.stringify(v)); }\n"
               % (BUS_NAME, BUS_NAME)) + js
        path = os.path.join(self.tmp, "script.js")
        with open(path, "w") as f:
            f.write(src)
        name = "plasma-reopen-windows"
        try:
            self._kwin("/Scripting", "org.kde.kwin.Scripting", "unloadScript", GLib.Variant("(s)", (name,)), "(b)")
        except GLib.Error:
            pass
        sid = self._kwin("/Scripting", "org.kde.kwin.Scripting", "loadScript",
                         GLib.Variant("(ss)", (path, name)), "(i)")[0]
        self.result = None
        self._kwin("/Scripting/Script%d" % sid, "org.kde.kwin.Script", "run", None, "()")
        timer = GLib.timeout_add(timeout * 1000, self.loop.quit)
        self.loop.run()
        if self.result is not None:
            GLib.source_remove(timer)
        self._kwin("/Scripting", "org.kde.kwin.Scripting", "unloadScript", GLib.Variant("(s)", (name,)), "(b)")
        if self.result is None:
            raise RuntimeError("KWin script did not answer")
        return json.loads(self.result)

    def windows(self):
        return self.run(JS_WINDOWS)

    def call(self, service, path, iface, method, args=None, sig="()"):
        return self.bus.call_sync(service, path, iface, method, args,
                                  GLib.VariantType(sig), 0, 10000).unpack()


JS_WINDOWS = r"""
const stack = workspace.stackingOrder;
let out = [];
for (const w of workspace.windowList()) {
    if (!w.normalWindow || w.skipTaskbar) continue;
    const g = w.frameGeometry;
    out.push({
        id: w.internalId.toString(),
        app: w.desktopFileName || w.resourceClass,
        cls: w.resourceClass,
        pid: w.pid,
        caption: w.caption,
        x: g.x, y: g.y, width: g.width, height: g.height,
        output: w.output ? w.output.name : "",
        desktops: w.desktops.map(d => d.id),
        activities: w.activities,
        minimized: w.minimized,
        maximize: w.maximizeMode,
        fullscreen: w.fullScreen,
        keepAbove: w.keepAbove,
        stack: stack.indexOf(w),
    });
}
result({ windows: out, outputs: workspace.screens.map(s => s.name) });
"""

JS_CLOSE = r"""
const ids = %s;
let n = 0;
for (const w of workspace.windowList()) {
    if (ids.indexOf(w.internalId.toString()) >= 0) { w.closeWindow(); n++; }
}
result(n);
"""

JS_PLACE = r"""
const moves = %s;
let done = [];
for (const w of workspace.windowList()) {
    const m = moves[w.internalId.toString()];
    if (!m) continue;
    try {
        if (m.desktops.length) {
            const d = workspace.desktops.filter(d => m.desktops.indexOf(d.id) >= 0);
            if (d.length) w.desktops = d;
        }
        if (w.fullScreen) w.fullScreen = false;
        if (w.maximizeMode) w.setMaximize(false, false);
        if (m.geometry) w.frameGeometry = m.geometry;
        if (m.maximize) w.setMaximize((m.maximize & 1) != 0, (m.maximize & 2) != 0);
        if (m.fullscreen) w.fullScreen = true;
        w.keepAbove = m.keepAbove;
        if (m.minimized) w.minimized = true;
        done.push(w.internalId.toString());
    } catch (e) { done.push("error " + e); }
}
result(done);
"""


JS_RAISE = r"""
const ids = %s;      // bottom to top
let byId = {};
for (const w of workspace.windowList()) byId[w.internalId.toString()] = w;
let top = null, n = 0;
for (const id of ids) {
    const w = byId[id];
    if (!w || w.minimized) continue;
    if (workspace.raiseWindow) workspace.raiseWindow(w); else workspace.activeWindow = w;
    top = w; n++;
}
if (top) workspace.activeWindow = top;
result(n);
"""


# ---- apps --------------------------------------------------------------------
def app_kind(app):
    if app in QUIT_BY_SIGNAL:
        return "signal"
    if app == "org.kde.konsole":
        return "konsole"
    if app == "org.kde.dolphin":
        return "dolphin"
    return "generic"


def ignored(app):
    return app in IGNORE or app in CFG.get("exclude", "").split()


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def proc_name(pid):
    try:
        with open("/proc/%d/comm" % pid) as f:
            return f.read().strip()
    except OSError:
        return "?"


def desktop_exists(app):
    return Gio.DesktopAppInfo.new(app + ".desktop") is not None


def app_name(app):
    info = Gio.DesktopAppInfo.new(app + ".desktop")
    return info.get_name() if info else app


def konsole_tabs(kw, pid):
    """[[cwd, ...] per window], and busy tabs [(cwd, program)]."""
    service = "org.kde.konsole-%d" % pid
    windows, busy = [], []
    try:
        xml = kw.call(service, "/Windows", "org.freedesktop.DBus.Introspectable", "Introspect", None, "(s)")[0]
    except GLib.Error:
        return None, []
    node = Gio.DBusNodeInfo.new_for_xml(xml)
    for child in sorted((n.path for n in node.nodes), key=lambda p: int(p) if p.isdigit() else 0):
        try:
            sessions = kw.call(service, "/Windows/" + child, "org.kde.konsole.Window", "sessionList", None, "(as)")[0]
        except GLib.Error:
            continue
        tabs = []
        for s in sessions:
            path = "/Sessions/" + s
            try:
                shell = kw.call(service, path, "org.kde.konsole.Session", "processId", None, "(i)")[0]
                fg = kw.call(service, path, "org.kde.konsole.Session", "foregroundProcessId", None, "(i)")[0]
                cwd = os.readlink("/proc/%d/cwd" % (fg if fg > 0 else shell))
            except (GLib.Error, OSError):
                continue
            tabs.append(cwd)
            if fg > 0 and fg != shell:
                busy.append((cwd, proc_name(fg)))
        if tabs:
            windows.append(tabs)
    return windows, busy


def quit_app(kw, app, kind, wins):
    """Ask an app to quit as a whole. Returns the pids to wait for."""
    pids = sorted({w["pid"] for w in wins if w["pid"] > 0})
    if kind == "signal" or kind == "konsole":
        for p in pids:
            os.kill(p, signal.SIGTERM)
    elif kind == "dolphin":
        for p in pids:
            try:
                kw.call("org.kde.dolphin-%d" % p, "/dolphin/Dolphin_1/actions/file_quit",
                        "org.qtproject.Qt.QAction", "trigger")
            except GLib.Error:
                kw.run(JS_CLOSE % json.dumps([w["id"] for w in wins if w["pid"] == p]))
    else:
        kw.run(JS_CLOSE % json.dumps([w["id"] for w in wins]))
    return pids


def wait_closed(kw, app, kind, wins, pids, timeout):
    """Generic apps may stay in the tray: for them, gone windows are enough."""
    ids = {w["id"] for w in wins}
    end = time.time() + timeout
    while time.time() < end:
        if kind == "generic":
            if not ids & {w["id"] for w in kw.windows()["windows"]}:
                return True
        elif not any(pid_alive(p) for p in pids):
            return True
        time.sleep(0.5)
    return False


# ---- save --------------------------------------------------------------------
def do_save(only=None):
    kw = KWin()
    snap = kw.windows()
    wins = [w for w in snap["windows"] if not ignored(w["app"])]
    if only:
        wins = [w for w in wins if w["app"] in only or app_kind(w["app"]) in only]
    apps = {}
    for w in sorted(wins, key=lambda w: w["stack"]):
        apps.setdefault(w["app"], []).append(w)

    # Konsole: folders per tab; a program running in a tab stops the shutdown
    konsole = {}
    busy = []
    for w in apps.get("org.kde.konsole", []):
        if w["pid"] not in konsole:
            tabs, b = konsole_tabs(kw, w["pid"])
            konsole[w["pid"]] = tabs or []
            busy += b
    if busy:
        msg = ", ".join("%s in %s" % (prog, cwd) for cwd, prog in busy)
        log("cancelled: programs running in Konsole: " + msg)
        notify("Shutdown cancelled", "Programs are still running in Konsole: %s. "
               "Finish or stop them, then try again." % msg, critical=True)
        return None

    if CFG.get("confirm") == "yes" and only is None:
        names = ", ".join(sorted(app_name(a) for a in apps)) or "no apps"
        r = subprocess.run(["kdialog", "--title", "Reopen windows", "--yesno",
                            "Close all apps, save the session and continue?\n\nOpen: %s" % names],
                           check=False)
        if r.returncode != 0:
            log("cancelled by the user")
            return None

    # While the apps still run: videos (position, paused) and the sound output
    media = [{k: p[k] for k in ("title", "position", "status")}
             for p in mpris_players(kw.bus) if p["title"] and p["status"] in ("Playing", "Paused")]
    sound = default_sink()
    for m in media:
        log("media: \"%s\" %s at %d s" % (m["title"][:50], m["status"].lower(), m["position"] // 1000000))
    if sound:
        log("sound output: %s" % (sound["nick"] or sound["name"]))

    notify("Saving session", "Closing %d apps…" % len(apps))
    log("saving: " + ", ".join("%s (%d)" % (a, len(ws)) for a, ws in apps.items()))
    launches = []
    timeout = int(CFG.get("close_timeout"))
    for app in sorted(apps, key=lambda a: ORDER[app_kind(a)]):
        kind, ws = app_kind(app), apps[app]
        launch = launch_spec(app, kind, ws, konsole)
        pids = quit_app(kw, app, kind, ws)
        if not wait_closed(kw, app, kind, ws, pids, timeout):
            log("cancelled: %s did not close within %d s" % (app, timeout))
            notify("Shutdown cancelled", "%s did not close (maybe it asks to save something). "
                   "Close it yourself, then try again. Reopening the apps closed so far." % app, critical=True)
            relaunch(launches)
            return None
        log("closed %s" % app)
        if launch:
            launches.append(launch)
        else:
            log("no desktop file for %s, it will not be started again" % app)

    state = {"saved": time.time(), "outputs": snap["outputs"],
             "launch": launches, "windows": wins, "media": media, "sound": sound}
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump(state, f, indent=1)
    os.replace(STATE + ".tmp", STATE)
    log("saved %d apps, %d windows to %s" % (len(launches), len(wins), STATE))
    return state


def launch_spec(app, kind, wins, konsole):
    if kind == "konsole":
        tabs = [t for pid in sorted({w["pid"] for w in wins}) for t in konsole.get(pid, [])]
        return {"app": app, "konsole": tabs or [[os.path.expanduser("~")]]}
    if desktop_exists(app):
        return {"app": app, "desktop": app}
    return None


def login_shell():
    return os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/bash"


def relaunch(launches):
    # tab lists from earlier restores (Konsole reads them within seconds)
    for f in os.listdir(STATE_DIR) if os.path.isdir(STATE_DIR) else []:
        path = os.path.join(STATE_DIR, f)
        if f.startswith("konsole-tabs-") and time.time() - os.path.getmtime(path) > 3600:
            os.remove(path)
    for spec in launches:
        if "konsole" in spec:
            for tabs in spec["konsole"]:
                # Konsole always adds its default tab after the ones from the file,
                # so the last tab is that default one (--workdir), the others go
                # in the file.
                cmd = ["kstart", "--", "konsole", "--workdir", tabs[-1]]
                if len(tabs) > 1:
                    fd, path = tempfile.mkstemp(prefix="konsole-tabs-", suffix=".txt", dir=STATE_DIR)
                    with os.fdopen(fd, "w") as f:
                        # each line needs a command; "%d : %n" is Konsole's default
                        # tab title (folder : program), so titles keep updating
                        f.writelines("title: %%d : %%n;; workdir: %s;; command: %s\n" % (t, login_shell())
                                     for t in tabs[:-1])
                    cmd += ["--tabs-from-file", path]
                subprocess.Popen(cmd)
        else:
            subprocess.Popen(["kstart", "--application", spec["desktop"]])
        log("started " + spec["app"])
        time.sleep(1)


def power(action):
    method = {"shutdown": "logoutAndShutdown", "reboot": "logoutAndReboot"}[action]
    log("asking Plasma to " + action)
    Gio.bus_get_sync(Gio.BusType.SESSION).call_sync(
        "org.kde.Shutdown", "/Shutdown", "org.kde.Shutdown", method, None, None, 0, -1)


# ---- restore -----------------------------------------------------------------
def strip_caption(c):
    for sep in (" — ", " - "):
        if sep in c:
            c = c.rsplit(sep, 1)[0]
    return c.strip().lower()


def place_windows_enabled():
    mode = CFG.get("place_windows")
    if mode in ("yes", "no"):
        return mode == "yes"
    kwinrc = configparser.ConfigParser(strict=False, interpolation=None)
    kwinrc.read(os.path.expanduser("~/.config/kwinrc"))
    other = kwinrc.get("Plugins", "rememberwindowpositionsEnabled", fallback="false") == "true"
    if other:
        log("\"Remember Window Positions\" is on; leaving window placement to it")
    return not other


def do_restore(state=None):
    if state is None:
        if not os.path.exists(STATE):
            return
        with open(STATE) as f:
            state = json.load(f)
        os.replace(STATE, STATE + ".restored")
    age = (time.time() - state["saved"]) / 86400
    if age > float(CFG.get("max_age_days")):
        log("saved session is %.0f days old, not restored" % age)
        return
    log("restoring %d apps" % len(state["launch"]))
    kw = KWin()
    before = {w["id"] for w in kw.windows()["windows"]}
    media = Media(kw.bus, state.get("media", []))
    # Videos start playing as soon as their tab loads, before they can be
    # paused again: keep the sound off until then (at most 30 s).
    muting = media.paused()
    if muting:
        wait_for_quiet()          # let the login sound finish
    muted = mute_outputs() if muting else []
    unmute_at = time.time() + 30
    try:
        relaunch(state["launch"])
        placer = Placer(kw, state, before, move=place_windows_enabled())
        sound = state.get("sound")
        end = time.time() + int(CFG.get("restore_timeout"))
        while time.time() < end:
            if sound and set_sound_output(sound):
                sound = None
            if muting:
                muted += mute_outputs(quiet=True)     # monitors that woke up late
            media.step()
            if muting and (not media.paused() or time.time() > unmute_at):
                unmute_outputs(muted)
                muted, muting = [], False
            placer.step()
            # done, or no further window for 20 s (an app may reopen fewer windows)
            if not sound and not media.todo and (not placer.todo or time.time() - placer.last_match > 20):
                break
            time.sleep(1.5)
        if sound:
            set_sound_output(sound, final=True)
    finally:
        unmute_outputs(muted)
    media.report()
    placer.report()
    if CFG.get("restore_stacking") == "yes":
        time.sleep(2)             # let other scripts finish placing windows first
        placer.restack()
    notify("Session restored", "%d apps started again" % len(state["launch"]))


class Placer:
    """Match new windows to saved ones (same app, most similar title), move them
    (if move) and, at the end, stack them in the saved order."""

    def __init__(self, kw, state, ignore_ids, move=True):
        self.kw, self.ignore, self.move = kw, ignore_ids, move
        self.matched = []    # (saved window, new window id)
        self.last_match = time.time()
        self.todo = {}
        for w in state["windows"]:
            self.todo.setdefault(w["app"], []).append(w)
        self.seen = {}       # window id -> passes seen without a good match

    def step(self):
        if not self.todo:
            return
        snap = self.kw.windows()
        outputs_now = set(snap["outputs"])
        moves = {}
        for w in snap["windows"]:
            if w["id"] in self.ignore or w["app"] not in self.todo:
                continue
            cands = self.todo[w["app"]]
            self.seen[w["id"]] = self.seen.get(w["id"], 0) + 1
            score, i = max((similar(strip_caption(w["caption"]), strip_caption(c["caption"])), i)
                           for i, c in enumerate(cands))
            # Titles fill in after loading; wait a few passes for a good match
            if score < 0.6 and self.seen[w["id"]] < 4:
                continue
            c = cands.pop(i)
            if not cands:
                del self.todo[w["app"]]
            self.ignore.add(w["id"])
            self.matched.append((c, w["id"]))
            self.last_match = time.time()
            if not self.move:
                continue
            moves[w["id"]] = {
                "geometry": ({"x": c["x"], "y": c["y"], "width": c["width"], "height": c["height"]}
                             if c["output"] in outputs_now else None),
                "desktops": c["desktops"], "maximize": c["maximize"], "fullscreen": c["fullscreen"],
                "keepAbove": c["keepAbove"], "minimized": c["minimized"],
            }
            log("placing %s \"%s\" as \"%s\" (match %.2f)" % (w["app"], w["caption"][:40], c["caption"][:40], score))
        if moves:
            self.kw.run(JS_PLACE % json.dumps(moves))

    def restack(self):
        order = [wid for c, wid in sorted(self.matched, key=lambda m: m[0]["stack"])]
        if order:
            n = self.kw.run(JS_RAISE % json.dumps(order))
            log("stacked %d windows in the saved order" % n)

    def report(self):
        if self.todo:
            log("not matched (window did not appear): " +
                ", ".join("%s x%d" % (a, len(c)) for a, c in self.todo.items()))


# ---- videos and sound output -------------------------------------------------
MPRIS = "org.mpris.MediaPlayer2"


def similar(a, b):
    return difflib.SequenceMatcher(None, a.strip().lower(), b.strip().lower()).ratio()


def mpris_players(bus):
    """Media players on D-Bus (Chrome reports each tab playing a video)."""
    names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "ListNames", None, GLib.VariantType("(as)"), 0, 5000).unpack()[0]
    out = []
    for n in names:
        if not n.startswith(MPRIS + "."):
            continue
        try:
            props = bus.call_sync(n, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "GetAll",
                                  GLib.Variant("(s)", (MPRIS + ".Player",)), GLib.VariantType("(a{sv})"),
                                  0, 3000).unpack()[0]
        except GLib.Error:
            continue
        md = props.get("Metadata", {})
        out.append({"bus": n, "title": md.get("xesam:title", ""), "trackid": md.get("mpris:trackid", ""),
                    "position": props.get("Position", 0), "status": props.get("PlaybackStatus", ""),
                    "can_seek": props.get("CanSeek", False)})
    return out


class Media:
    """Puts videos back at their saved position, paused or playing."""

    def __init__(self, bus, saved):
        self.bus = bus
        # a video near its start that was playing needs nothing
        self.todo = [dict(m, tries=0) for m in saved
                     if m["status"] == "Paused" or m["position"] > 5000000]
        self.done = []

    def step(self):
        if not self.todo:
            return
        players = mpris_players(self.bus)
        for m in list(self.todo):
            match = [p for p in players if similar(p["title"], m["title"]) >= 0.85]
            if not match:
                continue        # tab not loaded yet, or an ad is playing first
            p = match[0]
            players.remove(p)
            pos = p["position"]
            pos_ok = not p["can_seek"] or (pos >= m["position"] - 3000000 and
                                           (m["status"] == "Playing" or pos <= m["position"] + 3000000))
            if pos_ok and p["status"] == m["status"]:
                log("media: \"%s\" back at %d s, %s" % (m["title"][:50], pos // 1000000, m["status"].lower()))
                self.todo.remove(m)
                self.done.append(m)
                continue
            if m["tries"] >= 5:
                log("media: could not restore \"%s\"" % m["title"][:50])
                self.todo.remove(m)
                continue
            m["tries"] += 1
            try:
                if m["status"] == "Paused" and p["status"] != "Paused":
                    self._call(p["bus"], "Pause")
                if not pos_ok and p["trackid"]:
                    self._call(p["bus"], "SetPosition", GLib.Variant("(ox)", (p["trackid"], m["position"])))
                if m["status"] == "Playing" and p["status"] != "Playing":
                    self._call(p["bus"], "Play")
            except GLib.Error as e:
                log("media: %s" % e.message)

    def paused(self):
        return any(m["status"] == "Paused" for m in self.todo)

    def _call(self, name, method, args=None):
        self.bus.call_sync(name, "/org/mpris/MediaPlayer2", MPRIS + ".Player", method, args, None, 0, 3000)

    def report(self):
        for m in self.todo:
            log("media: \"%s\" did not appear (tab not opened yet?)" % m["title"][:50])


def sinks():
    try:
        data = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=10).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []
    for o in data:
        p = o.get("info", {}).get("props", {}) if o.get("type") == "PipeWire:Interface:Node" else {}
        if p.get("media.class") == "Audio/Sink":
            out.append({"id": o["id"], "name": p.get("node.name", ""), "nick": p.get("node.nick", ""),
                        "description": p.get("node.description", "")})
    return out


def wait_for_quiet(least=3, most=8):
    """Wait until no app plays sound (the login sound), within least..most s."""
    start = time.time()
    time.sleep(least)
    while time.time() - start < most:
        try:
            data = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True,
                                             timeout=10).stdout or "[]")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return
        playing = [o for o in data if o.get("type") == "PipeWire:Interface:Node"
                   and o.get("info", {}).get("props", {}).get("media.class") == "Stream/Output/Audio"
                   and o.get("info", {}).get("state") == "running"]
        if not playing:
            return
        time.sleep(0.5)


def mute_outputs(quiet=False):
    """Mute every sound output that is not muted yet; returns their ids."""
    ids = []
    for s in sinks():
        r = subprocess.run(["wpctl", "get-volume", str(s["id"])], capture_output=True, text=True, check=False)
        if "MUTED" not in r.stdout:
            subprocess.run(["wpctl", "set-mute", str(s["id"]), "1"], check=False)
            ids.append(s["id"])
    if ids and not quiet:
        log("sound muted until the paused videos are paused again")
    return ids


def unmute_outputs(ids):
    for i in ids:
        subprocess.run(["wpctl", "set-mute", str(i), "0"], check=False)
    if ids:
        log("sound on again")


def default_sink():
    try:
        r = subprocess.run(["wpctl", "inspect", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r'node\.name = "([^"]*)"', r.stdout)
    return next((s for s in sinks() if m and s["name"] == m.group(1)), None)


def set_sound_output(saved, final=False):
    """Select the saved output again. Monitors (HDMI/DisplayPort) are found by
    the monitor's name: their port numbers can change between boots."""
    all_sinks = sinks()
    by_nick = [s for s in all_sinks if s["nick"] and s["nick"] == saved["nick"]]
    target = by_nick[0] if len(by_nick) == 1 else None
    if target is None:
        if not final:
            return False      # the monitor may still be waking up
        target = next((s for s in all_sinks if s["name"] == saved["name"]), None)
        if target is None:
            log("sound output %s not found" % (saved["nick"] or saved["name"]))
            return False
    cur = default_sink()
    if cur and cur["id"] == target["id"]:
        log("sound output: %s (already selected)" % (target["nick"] or target["name"]))
    else:
        subprocess.run(["wpctl", "set-default", str(target["id"])], check=False)
        log("sound output: %s selected again" % (target["nick"] or target["name"]))
    return True


# ---- main --------------------------------------------------------------------
def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        if cmd in ("shutdown", "reboot"):
            if do_save() is not None:
                power(cmd)
        elif cmd == "save":
            # Testing: save (optionally only some apps: save chrome konsole ...), no power-off
            only = set(sys.argv[2:]) or None
            if only:
                only = {{"chrome": "google-chrome", "vscode": "code"}.get(o, o) for o in only}
            do_save(only)
        elif cmd == "restore":
            do_restore()
        elif cmd == "status":
            if os.path.exists(STATE):
                with open(STATE) as f:
                    s = json.load(f)
                print("saved %s" % time.strftime("%F %T", time.localtime(s["saved"])))
                for l in s["launch"]:
                    print("  start  %s %s" % (l["app"], l.get("konsole", "")))
                for w in s["windows"]:
                    print("  window %-28s %-9s %5d,%-5d %4dx%-4d %s" % (
                        w["app"][:28], w["output"], w["x"], w["y"], w["width"], w["height"], w["caption"][:50]))
            else:
                print("nothing saved")
        elif cmd == "windows":
            for w in KWin().windows()["windows"]:
                print("%-30s pid %-7d %-9s %5d,%-5d %4dx%-4d %s%s" % (
                    w["app"][:30], w["pid"], w["output"], w["x"], w["y"], w["width"], w["height"],
                    "[ignored] " if ignored(w["app"]) else "", w["caption"][:50]))
        else:
            print(__doc__)
            sys.exit(2)
    except Exception as e:
        log("ERROR: %s" % e)
        notify("Reopen windows: error", str(e), critical=True)
        raise


if __name__ == "__main__":
    main()
