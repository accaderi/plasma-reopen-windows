#!/usr/bin/python3
"""plasma-reopen-windows: Save & Shut Down / Save & Restart for KDE Plasma.

Launcher: uses the package next to this file (source checkout) or the
installed one in ~/.local/lib/plasma-reopen-windows.
"""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for path in (here, os.path.expanduser("~/.local/lib/plasma-reopen-windows")):
    if os.path.isdir(os.path.join(path, "plasma_reopen_windows")):
        sys.path.insert(0, path)
        break

from plasma_reopen_windows.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
